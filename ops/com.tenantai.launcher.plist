<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.tenantai.launcher</string>
  <key>ProgramArguments</key> <array><string>/bin/zsh</string><string>/Users/alejandroclaure/tenant-ai/start.sh</string></array>
  <key>WorkingDirectory</key> <string>/Users/alejandroclaure/tenant-ai</string>
  <key>RunAtLoad</key>        <true/>
  <!-- relaunch only when start.sh exits non-zero (a server died); a Ctrl-C /
       Dock takeover exits 0 and is left alone -->
  <key>KeepAlive</key>        <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key> <integer>60</integer>
  <key>StandardOutPath</key>  <string>/Users/alejandroclaure/Library/Logs/tenant-ai.log</string>
  <key>StandardErrorPath</key><string>/Users/alejandroclaure/Library/Logs/tenant-ai.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key> <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key> <string>/Users/alejandroclaure</string>
  </dict>
</dict>
</plist>
