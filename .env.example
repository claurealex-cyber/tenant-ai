# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Telnyx (SMS adapter — webhook: POST /telnyx/sms)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=   # base64 Ed25519 key from portal.telnyx.com → Account Settings → Public Key
TELNYX_ACCOUNT_SID=  # account id shown on TeXML applications — needed for call recording

# OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini-realtime-preview

# Database
DATABASE_URL=postgresql://tenant_ai:tenant_ai@localhost:5433/tenant_ai

# Encryption
PII_ENCRYPTION_KEY=   # 64-char hex — openssl rand -hex 32

# Stripe (Platform Billing — subscriptions for landlords)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Connect (Rent Payments — landlords as connected accounts)
STRIPE_CONNECT_CLIENT_ID=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# NextAuth (Landlord Dashboard)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# NextAuth (Tenant Site)
TENANT_AUTH_SECRET=
TENANT_SITE_URL=http://localhost:3002
# Optional: platform root domain for landlord subdomains, used to build texted
# survey links (e.g. {subdomain}.example.com). Falls back to TENANT_SITE_URL.
TENANT_SITE_ROOT_DOMAIN=

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6380

# Server
SERVER_PORT=3001
SERVER_HOST=0.0.0.0
PUBLIC_URL=http://localhost:3001
MAX_CONCURRENT_CALLS=10
DEFAULT_MAX_CALL_MINUTES=15

# File Storage (S3-compatible — MinIO in dev)
S3_BUCKET=tenant-ai-uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9002
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Illinois Compliance
IL_DEPOSIT_INTEREST_RATE=0.01

# Notifications
SENDGRID_API_KEY=
